# DARKPOOL backend — copy to .env (never commit .env)

# App
API_TOKEN=                # set to enable bearer auth (empty = open, dev only)
CORS_ORIGINS=http://localhost:3000

# Binance (public market data is keyless)
BINANCE_DATA_BASE=https://data-api.binance.vision

# Upstash Redis REST (optional — in-memory cache fallback when empty)
REDIS_REST_URL=
REDIS_REST_TOKEN=

# Supabase Postgres (wired in P1)
DATABASE_URL=

# LLM provider keys (all free-tier; see config/models.yaml for the roster)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
